<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <% users.forEach((el,ind) => { %>
            <div>
                <p><%= el.name%></p>
                <p><%= el.email%></p>
                <p><%= el.isActive%></p>
            </div>
        <% })%>
    </div>
</body>
</html>