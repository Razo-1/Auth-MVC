<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/userProfile/userProfile.css">
</head>
<body>
    <div>
        <h2 id="logout">Logout</h2>
    </div>
    <div>
        <% users.forEach((el,ind) => { %>
            <div>
                <p><%= el.name%></p>
                <p><%= el.email%></p>
                <p>Active Status : <%= el.isActive ? 'Online' : 'Offline' %></p>
            </div>
        <% })%>
    </div>

    <script src="/javascripts/userProfile/index.js"></script>
</body>
</html>